# 统一换行，避免跨平台全文件 diff
* text=auto

# Windows 专用文件保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.cs  text eol=crlf

# 文本文件用 LF
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf

# 二进制文件不做换行转换
*.exe  binary
*.ico  binary
*.png  binary
*.woff2 binary
*.zip  binary
